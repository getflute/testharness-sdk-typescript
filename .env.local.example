# Flute SDK Test Harness — credentials
#
# Copy this file to `.env.local` (already in .gitignore) and fill in the values.
# Treat clientSecret as a password. It must NEVER end up in the browser.
# Restart `npm run dev` after editing.

# Target environment. Accepted values:
#   sandbox | uat | dev | staging   → uses sandbox base URLs
#   production | prod | live        → uses production base URLs
FLUTE_ENV=sandbox

# OAuth 2.0 client credentials issued by Flute (ARISE-1845 onboarding).
FLUTE_CLIENT_ID=
FLUTE_CLIENT_SECRET=

# Optional: shared secret for the webhook endpoint you want to verify.
# Only used by the `webhooks.verifySignature` simulator — leave empty if
# you only test API endpoints.
FLUTE_WEBHOOK_SECRET=
