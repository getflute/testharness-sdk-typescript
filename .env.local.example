# Flute SDK Test Harness — credentials
#
# Copy this file to `.env.local` (already in .gitignore) and fill in the values.
# Treat clientSecret as a password. It must NEVER end up in the browser.
# Restart `npm run dev` after editing.

# Target environment. Accepted values:
#   sandbox     -> the public Flute sandbox (sandbox.api.flute.com)
#   production  -> live (api.flute.com)
#
# Anything else falls back to sandbox. Earlier versions of this file listed
# uat / dev / staging as aliases for sandbox; they were never separate
# environments in the SDK, and treating "uat" as a synonym for "sandbox" is
# what sent us looking for credentials in the wrong place for a week. To reach
# an internal environment, use the host overrides at the bottom.
FLUTE_ENV=sandbox

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# A SANDBOX account's MERCHANT-SCOPED key. Both of the easy mistakes
# authenticate successfully and then fail on real calls:
#
#   * A key created before switching into the sandbox account is a Live key,
#     and the sandbox host rejects it at the OAuth handshake.
#   * Developer -> API keys issues a PARTNER-scoped key, which carries no
#     merchant. The harness will load, the processor list will be empty, and
#     every transaction form will fail.
#
# To get the right one: sign up as a Partner on the dashboard, use the user
# menu to "Switch to Sandbox", then Merchants -> [merchant] -> API keys.
# Self-serve; nothing to request from anyone.
FLUTE_CLIENT_ID=
FLUTE_CLIENT_SECRET=

# Optional: shared secret for the webhook endpoint you want to verify.
# Only used by the `webhooks.verifySignature` simulator — leave empty if
# you only test API endpoints.
#
# It is returned once, in the response body when a webhook endpoint is
# created, and never shown again.
FLUTE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Host overrides — INTERNAL USE ONLY
# ---------------------------------------------------------------------------
# Applied on top of whatever FLUTE_ENV selects; anything omitted keeps the SDK
# default. Leave all three empty unless you are deliberately pointing the
# harness at an internal environment. UAT is internal and is not a path any
# integrator should be pointed at.
#
# Verified working against sandbox-uat:
#   FLUTE_ISV_API_URL=https://sandbox.api.uat.flute.com
#   FLUTE_PAY_INT_API_URL=https://sandbox.api.uat.flute.com/pay-int-api
#   FLUTE_OAUTH_URL=https://sandbox.oauth.api.uat.flute.com
FLUTE_ISV_API_URL=
FLUTE_PAY_INT_API_URL=
FLUTE_OAUTH_URL=
